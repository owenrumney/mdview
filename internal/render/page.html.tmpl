<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.StyleCSS}}</style>
</head>
<body data-theme="{{.Theme}}"{{if .Contents}} class="has-toc"{{end}}>
{{if .Contents}}
<nav class="mdview-toc" aria-label="Table of contents">
<div class="mdview-toc-inner">
<div class="mdview-toc-title">Contents</div>
<ul>
{{range .TOC}}<li class="toc-l{{.Level}}"><a href="#{{.ID}}">{{.Text}}</a></li>
{{end}}</ul>
</div>
</nav>
{{end}}
<main class="markdown-body">
{{.Body}}
</main>
<script>
  window.MDVIEW_MERMAID_THEME = "{{.MermaidTheme}}";
  window.MDVIEW_MERMAID_SECURITY = "{{.MermaidSecurity}}";
</script>
{{if .WatchMode}}
<script src="/assets/mermaid.min.js"></script>
{{else}}
<script>{{.MermaidInline}}</script>
{{end}}
<script>{{.MermaidInit}}</script>
<script>{{.CopyJS}}</script>
<script>{{.ZoomJS}}</script>
{{if .WatchMode}}
<script>
  (function () {
    var es = new EventSource('/events');
    es.addEventListener('reload', function () { location.reload(); });
  })();
</script>
{{end}}
</body>
</html>
